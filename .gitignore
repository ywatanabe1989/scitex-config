__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.python-version
.venv/
.venv-agent/
venv/
docs/sphinx/_build/
docs/sphinx/api/
# The served bundle src/<pkg>/_sphinx_html/ stays tracked; its .doctrees/
# subdirectory is sphinx-build's incremental-build scratch and is not part
# of it. The CI docs refresh copies the whole output dir, which is how it
# got committed.
src/*/_sphinx_html/.doctrees/
*.swp
.DS_Store

# .scitex/ is local state; only the tracked dev config is committed.
.scitex/*
!.scitex/dev/
.scitex/dev/*
!.scitex/dev/config.yaml
